{
  "name": "deutsch-memory-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "npm run data:audit && npm run course:audit && npm run grammar:audit",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "data:audit": "tsx scripts/auditContent.ts",
    "data:import": "tsx scripts/importContent.ts",
    "data:dashboard-manifest": "tsx scripts/buildDashboardManifest.ts",
    "test:content": "tsx scripts/testContentImport.ts",
    "course:add": "node scripts/addB2CourseUnit.mjs",
    "course:audit": "node scripts/auditB2Course.mjs",
    "course:test": "tsx scripts/testB2Course.ts && tsx scripts/testB2CourseSpeech.ts",
    "grammar:audit": "tsx scripts/auditB2Grammar.ts",
    "grammar:test": "tsx scripts/testB2Grammar.ts",
    "lint": "tsc --noEmit",
    "start": "node server.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.5.2",
    "esbuild": "0.28.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
